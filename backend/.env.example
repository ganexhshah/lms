APP_NAME="Vellum LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=8

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vellum
DB_USERNAME=vellum
DB_PASSWORD=secret

FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_UI_PORT=8025
FORWARD_MAILPIT_SMTP_PORT=1025

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@vellum.edu"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible CDN)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=lms
AWS_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_URL=https://pub-XXXX.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true

# Canva Connect — local redirects MUST use 127.0.0.1 (not localhost)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://127.0.0.1:8080/api/canva/callback
CANVA_FRONTEND_REDIRECT=http://127.0.0.1:3000/dashboard/certificates
CANVA_ID_CARD_TEMPLATE_ID=
CANVA_CERTIFICATE_TEMPLATE_ID=
CANVA_SCHOOL_NAME="Vellum LMS"
CANVA_EXPORT_FORMAT=pdf
CANVA_FIELD_STUDENT_NAME=student_name
CANVA_FIELD_STUDENT_CODE=student_code
CANVA_FIELD_COURSE=course
CANVA_FIELD_BATCH=batch
CANVA_FIELD_BLOOD_GROUP=blood_group
CANVA_FIELD_ISSUED_AT=issued_at
CANVA_FIELD_CERT_NUMBER=certificate_number
CANVA_FIELD_SCHOOL_NAME=school_name

VITE_APP_NAME="${APP_NAME}"
